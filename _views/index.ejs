<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="color-scheme" content="only dark" />
        <title>Portfsm</title>
        <link rel="stylesheet" href="/css/main.css" />
        <script src="/scripts/htmx.min.js"></script>
        <script src="/scripts/work-filter.js"></script>
    </head>
    <body>
        <header id="portfsm-header">
            <a
                class="portfsm-logo"
                href="/"
                hx-get="/pages/home"
                hx-target="#portfsm-main"
                hx-swap="innerHTML"
                hx-push-url="true"
            >
                <img src="/img/logo.svg" alt="{un}easy" />
            </a>
            <nav>
                <button
                    hx-get="/pages/home"
                    hx-target="#portfsm-main"
                    hx-swap="innerHTML"
                    hx-push-url="true"
                >
                    Startseite
                </button>
                <button
                    hx-get="/pages/about"
                    hx-target="#portfsm-main"
                    hx-swap="innerHTML"
                    hx-push-url="true"
                >
                    Über {un}easy
                </button>
            </nav>
        </header>

        <main
            id="portfsm-main"
            hx-get="<%= currentPage %>"
            hx-trigger="load"
            hx-swap="innerHTML"
        >
            <h3>Hello World</h3>
        </main>

        <footer id="portfsm-footer">
            <div class="portfsm-copy">
                &copy; <%= new Date().getFullYear() %> {un}easy
            </div>
            <nav>
                <a href="https://www.hs-mainz.de/impressum/">Impressum</a>
                <button
                    hx-get="/pages/privacy"
                    hx-target="#portfsm-main"
                    hx-swap="innerHTML"
                    hx-push-url="true"
                >
                    Datenschutz
                </button>
                <a href="#portfsm-main"> Seitenanfang </a>
            </nav>
        </footer>
    </body>
</html>
