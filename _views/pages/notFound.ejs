<div class="portfsm-not-found">
    <h1>404</h1>
    <h2>Page Not Found</h2>
    <p>Sorry, the page you're looking for doesn't exist or has been moved.</p>
    <button
        hx-get="/pages/home"
        hx-target="#portfsm-main"
        hx-swap="innerHTML show:window:top"
        hx-push-url="true"
        class="portfsm-btn"
    >
        Go back home
    </button>
</div>
